# Copy relevant keys into .env.local (local development) or .env.remote-e2e
# (remote-smoke suite). Never commit a filled-in .env* file — only this
# template is tracked.

# Names the exact remote Supabase project origin (e.g.
# https://<ref>.supabase.co) that a test/seed/setup script may run against
# instead of refusing (src/shared/lib/test-target-guard.ts). Required in
# .env.remote-e2e for the remote-smoke suite and
# scripts/seed-remote-e2e-admin.ts; leave unset for local development, where
# every guarded script targets the local loopback stack.
# ALLOW_REMOTE_SUPABASE_URL=

# PINs for the two fixed-UUID integration-test fixture staff accounts that
# scripts/setup-test-fixtures.ts provisions (see src/test/fixture-accounts.ts
# for the accounts' ids/emails/roles). Required for the ten report and
# close-tab integration tests that sign in as these accounts — they skip
# without these two keys.
E2E_FIXTURE_CASHIER_PIN=
E2E_FIXTURE_MANAGER_PIN=
