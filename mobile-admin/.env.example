# Local Supabase stack (npx supabase start in the repo root). 10.0.2.2 = host loopback from the Android emulator.
# For a physical phone on the same Wi-Fi use http://<your-pc-lan-ip>:54321.
# NEVER put the remote project's URL/key here — the remote project is off-limits for this app's dev loop.
EXPO_PUBLIC_SUPABASE_URL=http://10.0.2.2:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=<local anon key: run `npx supabase status` in the repo root>
