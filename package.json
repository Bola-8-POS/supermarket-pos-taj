{
  "name": "supermarket-pos",
  "private": true,
  "version": "1.10.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "cargo build --release --manifest-path broker/Cargo.toml && tsc && vite build",
    "build:web": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0 && npm run lint:functions-config && npm run lint:secrets && npm run lint:function-imports",
    "lint:fix": "eslint src --fix",
    "lint:functions-config": "node scripts/check-functions-config.mjs",
    "lint:secrets": "node scripts/check-secrets.mjs",
    "lint:function-imports": "node scripts/check-function-imports.mjs",
    "export:customer": "node scripts/export-customer-tree.mjs",
    "format": "prettier --write src",
    "test": "vitest run --project unit --reporter=dot",
    "test:integration": "vitest run --project integration --reporter=dot",
    "test:watch": "vitest --project unit",
    "test:storybook": "vitest run --project storybook",
    "test:ui": "vitest --ui --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "prepare": "husky",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build:storybook": "storybook build",
    "setup:dev-users": "npx tsx scripts/setup-dev-users.ts",
    "setup:test-fixtures": "npx tsx scripts/setup-test-fixtures.ts",
    "seed:dev": "npx tsx scripts/seed-dev-data.ts",
    "seed:demo": "npx tsx scripts/seed-demo.ts",
    "setup:dev": "npm run setup:dev-users && npm run setup:test-fixtures && npm run seed:dev",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:e2e:visual": "playwright test --config=playwright.visual.config.ts",
    "test:e2e:remote-smoke": "playwright test --config=playwright.remote.config.ts",
    "test:e2e:training": "playwright test --config=playwright.training.config.ts",
    "tutorial-videos:record": "playwright test --config=playwright.tutorial.config.ts",
    "tutorial-videos:convert": "tsx scripts/tutorial-videos-convert.ts",
    "tutorial-videos": "npm run tutorial-videos:record && npm run tutorial-videos:convert",
    "test:e2e:license": "playwright test --config=playwright.license.config.ts",
    "test:e2e:csp": "playwright test --config=playwright.csp.config.ts",
    "test:e2e:license:live": "playwright test --config=playwright.license-live.config.ts",
    "test:deno": "deno test --allow-env --config supabase/functions/deno.json --frozen supabase/functions/_shared",
    "deno:lock": "node scripts/deno-functions.mjs lock",
    "deno:check": "node scripts/deno-functions.mjs check",
    "docs:tokens": "npx tsx scripts/generate-design-tokens.ts",
    "audit:tech-debt": "bash scripts/run-tech-debt-audit.sh"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.8",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-pdf/renderer": "^4.5.1",
    "@supabase/supabase-js": "^2.103.0",
    "@tanstack/react-query": "^5.99.0",
    "@tanstack/react-table": "^8.21.3",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-fs": "^2.5.0",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "i18next": "26.3.6",
    "input-otp": "^1.2.4",
    "libphonenumber-js": "^1.12.42",
    "lucide-react": "^1.8.0",
    "radix-ui": "^1.4.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "17.0.10",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.2.0",
    "sonner": "^2.0.7",
    "supabase": "^2.91.1",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.1.2",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.59.1",
    "@storybook/addon-a11y": "^10.3.5",
    "@storybook/addon-docs": "^10.3.5",
    "@storybook/addon-onboarding": "^10.3.5",
    "@storybook/addon-vitest": "^10.3.5",
    "@storybook/react-vite": "^10.3.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/browser-playwright": "^5.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/ui": "^5.0.0",
    "autoprefixer": "^10.5.0",
    "dotenv": "^16.6.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-boundaries": "^6.0.2",
    "eslint-plugin-i18next": "6.1.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-no-relative-import-paths": "^1.6.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-storybook": "^10.3.5",
    "eslint-plugin-tailwindcss": "^4.2.0",
    "fast-check": "^4.6.0",
    "glob": "^13.0.6",
    "husky": "^9.1.7",
    "jscpd": "^5.0.14",
    "jsdom": "^29.0.2",
    "knip": "^6.31.0",
    "lint-staged": "^16.4.0",
    "madge": "^8.0.0",
    "playwright": "^1.59.1",
    "postcss": "^8.5.10",
    "prettier": "^3.8.2",
    "storybook": "^10.3.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.58.2",
    "vite": "^7.0.4",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
